<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Andando Música</title>

<!-- CONFIGURAÇÃO DO APP -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#0757b8">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#f3f7fc;
    color:#172033;
}

/* CABEÇALHO */

header{
    background:#0757b8;
    color:white;
    padding:18px;
    position:sticky;
    top:0;
    z-index:100;
    box-shadow:0 3px 12px rgba(0,0,0,.18);
}

.header{
    max-width:1100px;
    margin:auto;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
}

.logo{
    font-size:28px;
    font-weight:bold;
}

.logo span{
    color:#9fd0ff;
}

nav{
    display:flex;
    gap:20px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
}

/* BANNER */

.hero{
    background:linear-gradient(
        135deg,
        #06356f,
        #0879ed
    );

    color:white;
    padding:65px 20px;
}

.hero-content{
    max-width:1100px;
    margin:auto;
}

.hero h1{
    font-size:clamp(34px,6vw,55px);
    margin-bottom:15px;
}

.hero p{
    max-width:650px;
    font-size:19px;
    line-height:1.6;
    color:#e2efff;
    margin-bottom:25px;
}

.btn{
    display:inline-block;
    border:0;
    border-radius:10px;
    padding:13px 18px;
    font-weight:bold;
    cursor:pointer;
    text-decoration:none;
}

.btn-white{
    background:white;
    color:#0757b8;
}

/* CONTAINER */

.container{
    max-width:1100px;
    margin:auto;
    padding:35px 18px;
}

/* BUSCA */

.search-box{
    background:white;
    padding:18px;
    border-radius:15px;
    box-shadow:0 5px 18px rgba(0,0,0,.08);
    margin-bottom:30px;
}

.search-grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:10px;
}

.search-grid input,
.search-grid select{
    width:100%;
    padding:14px;
    border:1px solid #ccd8e8;
    border-radius:9px;
    font-size:15px;
}

/* TITULO */

.section-title{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.section-title h2{
    color:#0757b8;
}

#contador{
    color:#667085;
}

/* PRODUTOS */

.products{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.card{
    background:white;
    border-radius:16px;
    overflow:hidden;
    border:1px solid #e0e8f3;
    box-shadow
